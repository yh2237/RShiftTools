<Window
    x:Class="RShiftTools.Views.CutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="カット - RShiftTools"
    Width="780"
    Height="620"
    MinWidth="640"
    MinHeight="500"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,4"
            BorderBrush="#333"
            BorderThickness="1"
            Background="Black">
            <Grid>
                <MediaElement
                    x:Name="MediaPlayer"
                    LoadedBehavior="Manual"
                    MediaEnded="MediaPlayer_MediaEnded"
                    MediaFailed="MediaPlayer_MediaFailed"
                    MediaOpened="MediaPlayer_MediaOpened"
                    ScrubbingEnabled="True"
                    Stretch="Uniform"
                    UnloadedBehavior="Stop" />
                <TextBlock
                    x:Name="PreviewUnavailableMsg"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="#999"
                    Text="プレビュー非対応形式"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Slider
                x:Name="SeekSlider"
                IsMoveToPointEnabled="False"
                Maximum="{Binding TotalSeconds}"
                Minimum="0"
                PreviewMouseDown="SeekSlider_PreviewMouseDown"
                PreviewMouseMove="SeekSlider_PreviewMouseMove"
                PreviewMouseUp="SeekSlider_PreviewMouseUp"
                Value="{Binding CurrentSeconds, Mode=OneWay}" />
            <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False">
                <Rectangle
                    x:Name="InMarker"
                    Canvas.Bottom="0"
                    Width="3"
                    Height="22"
                    Fill="#00cc66"
                    Opacity="0.85" />
                <Rectangle
                    x:Name="OutMarker"
                    Canvas.Bottom="0"
                    Width="3"
                    Height="22"
                    Fill="#cc3300"
                    Opacity="0.85" />
            </Canvas>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button
                    Width="34" Height="28" Margin="0,0,2,0"
                    FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Click="ToStart_Click" ToolTip="IN点へ">&#xE892;</Button>
                <Button
                    Width="34" Height="28" Margin="0,0,2,0"
                    FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Click="FrameBack_Click" ToolTip="1フレーム戻る">&#xE76B;</Button>
                <Button
                    Width="48" Height="28" Margin="0,0,2,0"
                    FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Click="PlayPause_Click" ToolTip="再生/停止">
                    <TextBlock
                        FontFamily="Segoe MDL2 Assets" FontSize="12"
                        Text="{Binding PlayButtonText}" />
                </Button>
                <Button
                    Width="34" Height="28" Margin="0,0,2,0"
                    FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Click="FrameForward_Click" ToolTip="1フレーム進む">&#xE76C;</Button>
                <Button
                    Width="34" Height="28" Margin="0,0,2,0"
                    FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Click="ToEnd_Click" ToolTip="OUT点へ">&#xE893;</Button>
                <Separator Width="1" Margin="6,2" />
                <TextBlock Margin="4,0,2,0" VerticalAlignment="Center" Text="現在：" />
                <TextBox x:Name="CurrentTimeTextBox" Width="130" FontFamily="Consolas" KeyDown="CurrentTimeTextBox_KeyDown" Text="{Binding CurrentTimeText, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="速度：" />
                <ComboBox Width="64" Height="26" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding PlaybackSpeed}" />
                <Separator Width="1" Margin="6,2" />
                <TextBlock Margin="2,0,4,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="{Binding VolumeIcon}" />
                <Slider x:Name="VolumeSlider" Width="100" VerticalAlignment="Center" Maximum="100" Minimum="0" Value="{Binding Volume, Mode=TwoWay}" />
                <TextBlock Width="36" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding VolumeText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="8,6" BorderBrush="#00cc66" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,4" FontWeight="Bold" Foreground="#00cc66" Text="IN 点" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,4,0" FontFamily="Consolas" Text="{Binding InPointText, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Padding="6,2" Click="SetIn_Click" Content="現在位置" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="8,6" BorderBrush="#cc3300" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,4" FontWeight="Bold" Foreground="#cc3300" Text="OUT 点" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,4,0" FontFamily="Consolas" Text="{Binding OutPointText, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Padding="6,2" Click="SetOut_Click" Content="現在位置" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="0,0,0,4" Padding="8,6" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding CrfLabel}" />
                <Slider Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" Maximum="51" Minimum="0" TickFrequency="1" Value="{Binding Crf}" />
                <TextBlock Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center" Text="HW：" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding HwEncoders}" SelectedItem="{Binding HwEncoder}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,0,0,4">
            <ProgressBar Height="14" Margin="0,0,0,2" Maximum="100" Value="{Binding Progress}" />
            <TextBlock Foreground="#555" Text="{Binding StatusText}" />
        </StackPanel>

        <Grid Grid.Row="7">
            <Button Width="120" Height="28" HorizontalAlignment="Left" Click="OpenFolderButton_Click" Content="フォルダを開く" IsEnabled="{Binding HasOutput}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="80" Height="28" Margin="0,0,8,0" Click="CancelButton_Click" Content="キャンセル" />
                <Button Width="80" Height="28" Click="RunButton_Click" Content="カット" IsEnabled="{Binding CanRun}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
