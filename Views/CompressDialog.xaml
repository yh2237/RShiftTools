<Window
    x:Class="RShiftTools.Views.CompressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RShiftTools.Converters"
    Title="ファイルサイズ縮小 - RShiftTools"
    Width="720"
    Height="620"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StatusConverter x:Key="StatusConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter Property="Foreground" Value="#2ecc71" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="#e74c3c" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Processing">
                    <Setter Property="Foreground" Value="#3498db" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#f39c12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="12,8"
            BorderBrush="#DDD"
            BorderThickness="1"
            Visibility="{Binding IsSizeMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,6"
                    VerticalAlignment="Center"
                    Text="目標サイズ：" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,8,6"
                    Text="{Binding TargetSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,8,6"
                    VerticalAlignment="Center"
                    Text="単位：" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,6"
                    ItemsSource="{Binding SizeUnits}"
                    SelectedItem="{Binding SelectedSizeUnit}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,6"
                    VerticalAlignment="Center"
                    Text="音声品質："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,6"
                    ItemsSource="{Binding AudioQualities}"
                    SelectedItem="{Binding AudioQuality}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="ハードウェア："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    ItemsSource="{Binding HwEncoders}"
                    SelectedItem="{Binding HwEncoder}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    Text="サイズ精度：" />
                <ComboBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding AccuracyModes}"
                    SelectedItem="{Binding AccuracyMode}" />
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,6,0,0"
                    Content="入力がすでに目標以下ならスキップ"
                    IsChecked="{Binding SkipFilesAlreadyWithinTarget}" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    Text="解像度："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding ResolutionModes}"
                    SelectedItem="{Binding ResolutionMode}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    Text="映像コーデック："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="6"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding VideoCodecs}"
                    SelectedItem="{Binding VideoCodec}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    Text="FPS上限："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="7"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding FrameRateCaps}"
                    SelectedItem="{Binding FrameRateCap}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="8"
                    Grid.Column="0"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    Text="字幕："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="8"
                    Grid.Column="1"
                    Grid.ColumnSpan="1"
                    Margin="0,6,8,0"
                    ItemsSource="{Binding SubtitleModes}"
                    SelectedItem="{Binding SubtitleMode}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="8"
                    Grid.Column="2"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    Text="メタデータ："
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <ComboBox
                    Grid.Row="8"
                    Grid.Column="3"
                    Grid.ColumnSpan="2"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding MetadataModes}"
                    SelectedItem="{Binding MetadataMode}"
                    Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Grid.Row="9"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Margin="0,6,0,0"
                    Foreground="#555"
                    Text="{Binding EstimateText}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="12,8"
            BorderBrush="#DDD"
            BorderThickness="1"
            Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    Foreground="#555"
                    Text="{Binding ImageQualityLabel}" />
                <Slider
                    IsSnapToTickEnabled="True"
                    Maximum="{Binding ImageQualityMax}"
                    Minimum="{Binding ImageQualityMin}"
                    TickFrequency="1"
                    Value="{Binding ImageQuality}" />
                <CheckBox
                    Margin="0,10,0,4"
                    Content="目標ファイルサイズを指定"
                    IsChecked="{Binding ImageTargetEnabled}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="目標：" />
                    <TextBox
                        Width="90"
                        Margin="6,0,6,0"
                        Text="{Binding ImageTargetSizeKb, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="KB以下" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView
            Grid.Row="1"
            Margin="0,0,0,8"
            ItemsSource="{Binding Files}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="240"
                        DisplayMemberBinding="{Binding FileName}"
                        Header="ファイル名" />
                    <GridViewColumn
                        Width="80"
                        DisplayMemberBinding="{Binding FileSizeText}"
                        Header="入力" />
                    <GridViewColumn
                        Width="180"
                        DisplayMemberBinding="{Binding Details}"
                        Header="出力結果" />
                    <GridViewColumn Width="80" Header="進捗">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar
                                    Width="70"
                                    Height="14"
                                    Maximum="100"
                                    Value="{Binding Progress}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80" Header="状態">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Style="{StaticResource StatusTextStyle}"
                                    Text="{Binding Status, Converter={StaticResource StatusConverter}}"
                                    ToolTip="{Binding ErrorMessage}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ProgressBar
                Height="18"
                Margin="0,0,0,4"
                Maximum="100"
                Value="{Binding TotalProgress}" />
            <TextBlock Foreground="#555" Text="{Binding StatusText}" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Button
                Width="130"
                HorizontalAlignment="Left"
                Click="OpenFolderButton_Click"
                Content="フォルダを開く"
                IsEnabled="{Binding HasOutput}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="90"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Content="キャンセル" />
                <Button
                    Width="90"
                    Click="RunButton_Click"
                    Content="圧縮開始"
                    IsEnabled="{Binding CanRun}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
