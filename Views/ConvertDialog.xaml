<Window
    x:Class="RShiftTools.Views.ConvertDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RShiftTools.Converters"
    Title="変換 - RShiftTools"
    Width="580"
    Height="540"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:StatusConverter x:Key="StatusConverter" />
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter Property="Foreground" Value="#2ecc71" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="#e74c3c" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Processing">
                    <Setter Property="Foreground" Value="#3498db" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#f39c12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="変換先フォーマット：" />
            <ComboBox
                Width="180"
                ItemsSource="{Binding Formats}"
                SelectedItem="{Binding SelectedFormat}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="12,8"
            BorderBrush="#DDD"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,6"
                    VerticalAlignment="Center"
                    Text="エンコード：" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,16,6"
                    ItemsSource="{Binding EncodeModes}"
                    SelectedItem="{Binding EncodeMode}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,8,6"
                    VerticalAlignment="Center"
                    Text="ハードウェア：" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="0,0,0,6"
                    ItemsSource="{Binding HwEncoders}"
                    SelectedItem="{Binding HwEncoder}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,6"
                    VerticalAlignment="Center"
                    Text="{Binding CrfLabel}" />
                <Slider
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,6"
                    IsEnabled="{Binding IsCrfEnabled}"
                    IsSnapToTickEnabled="True"
                    Maximum="51"
                    Minimum="0"
                    TickFrequency="1"
                    Value="{Binding Crf}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="字幕：" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    ItemsSource="{Binding SubtitleModes}"
                    SelectedItem="{Binding SubtitleMode}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="12,8"
            BorderBrush="#f39c12"
            BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGifSelected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="{Binding GifFpsLabel}" />
                <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="60"
                    Minimum="1"
                    TickFrequency="1"
                    Value="{Binding GifFps}" />

                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="{Binding GifScaleLabel}" />
                <Slider
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="1920"
                    Minimum="64"
                    TickFrequency="16"
                    Value="{Binding GifScale}" />
            </Grid>
        </Border>

        <ListView
            Grid.Row="3"
            Margin="0,0,0,8"
            ItemsSource="{Binding Files}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="240"
                        DisplayMemberBinding="{Binding FileName}"
                        Header="ファイル名" />
                    <GridViewColumn
                        Width="80"
                        DisplayMemberBinding="{Binding FileSizeText}"
                        Header="サイズ" />
                    <GridViewColumn Width="80" Header="進捗">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar
                                    Width="70"
                                    Height="14"
                                    Maximum="100"
                                    Value="{Binding Progress}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="80" Header="状態">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Style="{StaticResource StatusTextStyle}"
                                    Text="{Binding Status, Converter={StaticResource StatusConverter}}"
                                    ToolTip="{Binding ErrorMessage}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <ProgressBar
                Height="18"
                Margin="0,0,0,4"
                Maximum="100"
                Value="{Binding TotalProgress}" />
            <TextBlock Foreground="#555" Text="{Binding StatusText}" />
        </StackPanel>

        <Grid Grid.Row="5">
            <Button
                Width="130"
                HorizontalAlignment="Left"
                Click="OpenFolderButton_Click"
                Content="フォルダを開く"
                IsEnabled="{Binding HasOutput}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="90"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Content="キャンセル" />
                <Button
                    Width="90"
                    Click="RunButton_Click"
                    Content="変換開始"
                    IsEnabled="{Binding CanRun}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
