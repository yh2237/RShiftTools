<Window
    x:Class="RShiftTools.Views.ModeSelectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="モードを選択"
    Width="340"
    Height="290"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="13"
            FontWeight="SemiBold"
            Text="実行するモードを選択してください" />

        <StackPanel x:Name="ModePanel" Grid.Row="2">
            <RadioButton
                x:Name="RadioConvert"
                Margin="0,4"
                Content="変換  —  動画・音声を別フォーマットに変換"
                IsChecked="True"
                Tag="convert" />
            <RadioButton
                x:Name="RadioResize"
                Margin="0,4"
                Content="リサイズ  —  解像度・アスペクト比を変更"
                Tag="resize" />
            <RadioButton
                x:Name="RadioCut"
                Margin="0,4"
                Content="カット  —  特定範囲を切り出す"
                Tag="cut" />
            <RadioButton
                x:Name="RadioCompress"
                Margin="0,4"
                Content="ファイルサイズ縮小  —  容量を小さくする"
                Tag="compress" />
            <RadioButton
                x:Name="RadioAudioEdit"
                Margin="0,4"
                Content="音声を編集  —  ビット深度などを変更"
                Tag="audio-edit" />
        </StackPanel>

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Click="OK_Click"
                Content="OK"
                IsDefault="True" />
            <Button
                Width="80"
                Click="Cancel_Click"
                Content="キャンセル"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
