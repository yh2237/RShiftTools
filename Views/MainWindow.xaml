<Window
    x:Class="RShiftTools.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding CurrentPath, StringFormat='RShiftTools - {0}', TargetNullValue='RShiftTools - PC', FallbackValue='RShiftTools - PC'}"
    Width="720"
    Height="520"
    MinWidth="480"
    MinHeight="360"
    AllowDrop="True"
    DragEnter="Window_DragEnter"
    Drop="Window_Drop"
    WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Click="MenuOpenFile_Click" Header="ファイルを開く(_O)..." />
                <Separator />
                <MenuItem Click="MenuExit_Click" Header="終了(_X)" />
            </MenuItem>
            <MenuItem Header="設定(_S)">
                <MenuItem Click="MenuSettings_Click" Header="設定を開く(_S)..." />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Click="MenuLicense_Click" Header="ライセンスを表示(_L)" />
                <Separator />
                <MenuItem Click="MenuGitHub_Click" Header="GitHubを開く(_G)" />
                <Separator />
                <MenuItem Click="MenuAbout_Click" Header="バージョン情報(_A)..." />
            </MenuItem>
        </Menu>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Height="24"
                    VerticalAlignment="Center"
                    IsReadOnly="{Binding IsDrivesMode}"
                    Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="現在のフォルダ" />
                <Button
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="2,0,0,0"
                    Padding="0"
                    BorderBrush="Transparent"
                    Background="Transparent"
                    Click="GoUp_Click"
                    IsEnabled="{Binding CanGoUp}"
                    ToolTip="上のフォルダへ">
                    <Image
                        Width="16"
                        Height="16"
                        Source="{Binding UpIcon}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    Grid.Column="2"
                    Height="24"
                    Margin="4,0,0,0"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    Click="BrowseFolder_Click"
                    ToolTip="フォルダを選択">参照...</Button>
            </Grid>

            <ListView
                Grid.Row="1"
                x:Name="FileListView"
                Foreground="Black"
                ItemsSource="{Binding Files}"
                SelectionChanged="FileListView_SelectionChanged"
                SelectionMode="Extended"
                MouseDoubleClick="FileListView_MouseDoubleClick"
                VirtualizingPanel.ScrollUnit="Item">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="CtxConvert_Click" Header="変換(_C)..." />
                        <MenuItem Click="CtxResize_Click" Header="リサイズ(_R)..." />
                        <MenuItem Click="CtxCut_Click" Header="カット(_T)..." />
                        <MenuItem Click="CtxCompress_Click" Header="ファイルサイズ縮小(_S)..." />
                        <Separator />
                        <MenuItem Click="CtxAudioEdit_Click" Header="音声を編集(_A)..." />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="300" Header="名前">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Source="{Binding IconSource}"
                                            Stretch="Uniform" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90" Header="サイズ">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="70" Header="種類">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeLabel}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150" Header="更新日時">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Modified, StringFormat=yyyy/MM/dd HH:mm}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border
                Grid.Row="2"
                Margin="0,6,0,0"
                Padding="8"
                BorderBrush="#BBB"
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Width="80"
                            Margin="0,0,6,0"
                            Click="ToolConvert_Click"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="選択したファイルを別フォーマットに変換">変換</Button>
                        <Button
                            Width="80"
                            Margin="0,0,6,0"
                            Click="ToolResize_Click"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="動画の解像度を変更">リサイズ</Button>
                        <Button
                            Width="80"
                            Margin="0,0,6,0"
                            Click="ToolCut_Click"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="動画の特定範囲を切り出す">カット</Button>
                        <Button
                            Width="120"
                            Margin="0,0,6,0"
                            Click="ToolCompress_Click"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="ファイルサイズを縮小">ファイルサイズ縮小</Button>
                        <Button
                            Width="100"
                            Click="ToolAudioEdit_Click"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="ビット深度・サンプルレート・チャンネル数を変更">音声を編集</Button>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#888"
                        Text="{Binding SelectedCount, StringFormat='{}選択中: {0} 件'}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
