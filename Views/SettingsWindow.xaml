<Window
    x:Class="RShiftTools.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="設定 - RShiftTools"
    Width="440"
    Height="300"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="2"
            Padding="12,10"
            BorderBrush="#FFF"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="デフォルトのハードウェアエンコード：" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding HwEncoders}"
                    SelectedItem="{Binding HwEncoder}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="4"
            Padding="12,10"
            BorderBrush="#FFF"
            BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="右クリックメニューの表示：" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding ContextMenuModes}"
                    SelectedItem="{Binding ContextMenuMode}" />
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="6"
            Margin="0,4,0,0"
            Foreground="#2ecc71"
            Text="{Binding InstallStatus}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Click="Apply_Click"
                Content="OK" />
            <Button
                Width="80"
                Click="Close_Click"
                Content="閉じる" />
        </StackPanel>
    </Grid>
</Window>
